#include <windows.h>

#define IDI_FRAMECAP 101

IDI_FRAMECAP ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "FrameCap - WebM screen recorder\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "ProductName", "FrameCap\0"
            VALUE "ProductVersion", "0.1.0\0"
            VALUE "OriginalFilename", "FrameCap.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#ifdef FRAMECAP_EMBED_RC_MANIFEST
1 RT_MANIFEST "app.manifest"
#endif
